# Vorlage für bin/deploy. Kopieren nach deploy.local.env (wird von Git ignoriert) und ausfüllen.
# Hier niemals echte Werte eintragen – diese Datei ist öffentlich im Repository.

# SSH-Ziel: <benutzer>@<host> oder ein Host-Alias aus ~/.ssh/config („local“ testet in einen lokalen Ordner)
DEPLOY_SSH="<benutzer>@<host>"
# Optional – leer lassen, wenn der Port in ~/.ssh/config steht
DEPLOY_PORT=""

# Projektordner auf dem Server (NICHT der Web-Root – der zeigt auf dessen Unterordner public/)
DEPLOY_PATH="<pfad-zum-projektordner-auf-dem-server>"

# PHP- und Composer-Aufruf auf dem Server (bei manchen Hostern z. B. eine versionsspezifische PHP-CLI)
DEPLOY_PHP="php"
DEPLOY_COMPOSER="composer"
