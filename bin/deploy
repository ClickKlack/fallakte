#!/usr/bin/env bash
# Deployment von „Amis Fallakte“ auf einen Webspace mit SSH und Composer (ohne Node).
#
#   bin/deploy <major|minor|patch|none> [--dry-run]
#
# Ablauf: Vorabprüfungen und Tests → Version hochzählen → Frontend bauen → (nach Rückfrage)
# Release-Commit (nur VERSION), Tag und Push → Upload per rsync (inkl. frisch gebautem public/build,
# das nicht im Repository liegt) → composer install, Migrationen, Caches auf dem Server.
#
# Ziel und Zugang stehen ausschließlich in der lokalen, von Git ignorierten Datei deploy.local.env
# (Vorlage: deploy.example.env). Niemals Hosts, Pfade oder Zugangsdaten in dieses Skript schreiben.
set -euo pipefail

cd "$(dirname "$0")/.."

BUMP="${1:-}"
DRY_RUN=false
[[ "${2:-}" == "--dry-run" ]] && DRY_RUN=true

say()  { printf '\n\033[1;34m▸ %s\033[0m\n' "$*"; }
# Versionsänderung verwerfen (z. B. bei Abbruch oder im Probelauf)
restore_version() { git checkout -q -- VERSION 2>/dev/null || true; }
fail() { printf '\n\033[1;31m✖ %s\033[0m\n' "$*" >&2; exit 1; }

case "$BUMP" in
    major|minor|patch|none) ;;
    *) fail "Aufruf: bin/deploy <major|minor|patch|none> [--dry-run]" ;;
esac

# --- Konfiguration -------------------------------------------------------------------------
[[ -f deploy.local.env ]] || fail "deploy.local.env fehlt – Vorlage deploy.example.env kopieren und ausfüllen."
# shellcheck disable=SC1091
source deploy.local.env
: "${DEPLOY_SSH:?DEPLOY_SSH fehlt in deploy.local.env}"
: "${DEPLOY_PATH:?DEPLOY_PATH fehlt in deploy.local.env}"
# Port nur setzen, wenn angegeben – sonst gilt die SSH-Konfiguration (z. B. eines Host-Alias)
DEPLOY_PORT="${DEPLOY_PORT:-}"
SSH_CMD=(ssh)
[[ -n "$DEPLOY_PORT" ]] && SSH_CMD+=(-p "$DEPLOY_PORT")
DEPLOY_PHP="${DEPLOY_PHP:-php}"
DEPLOY_COMPOSER="${DEPLOY_COMPOSER:-composer}"

# DEPLOY_SSH=local führt alles im lokalen Ordner DEPLOY_PATH aus (zum Testen des Skripts)
remote() {
    if [[ "$DEPLOY_SSH" == "local" ]]; then
        (cd "$DEPLOY_PATH" && bash -c "$1")
    else
        "${SSH_CMD[@]}" "$DEPLOY_SSH" "cd '$DEPLOY_PATH' && $1"
    fi
}

# --- Vorabprüfungen ------------------------------------------------------------------------
say "Vorabprüfungen"
[[ -z "$(git status --porcelain)" ]] || fail "Es gibt nicht committete Änderungen. Bitte zuerst committen."
[[ "$(git rev-parse --abbrev-ref HEAD)" == "main" ]] || fail "Deployment nur vom Branch main."

say "Tests und Code-Stil"
php artisan test --compact
npm run test --silent
vendor/bin/pint --test
npm run format:check --silent

# --- Version -------------------------------------------------------------------------------
CURRENT="$(tr -d '[:space:]' < VERSION)"
[[ "${CURRENT}" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || fail "VERSION enthält keine gültige Version: ${CURRENT}"
MAJOR="${BASH_REMATCH[1]}"; MINOR="${BASH_REMATCH[2]}"; PATCH="${BASH_REMATCH[3]}"
case "$BUMP" in
    major) NEXT="$((MAJOR + 1)).0.0" ;;
    minor) NEXT="$MAJOR.$((MINOR + 1)).0" ;;
    patch) NEXT="$MAJOR.$MINOR.$((PATCH + 1))" ;;
    none)  NEXT="${CURRENT}" ;;
esac
say "Version: ${CURRENT} → ${NEXT}"

# --- Build ---------------------------------------------------------------------------------
say "Frontend bauen"
npm run build --silent >/dev/null

# Der Build (public/build) ist nicht im Repository – er wird gleich direkt hochgeladen.
# Eine neue Version wird als Release-Commit (nur die Datei VERSION) mit Tag festgehalten.
if [[ "${NEXT}" != "${CURRENT}" ]]; then
    if $DRY_RUN; then
        say "[Probelauf] Würde VERSION=${NEXT} setzen, „chore: release v${NEXT}“ committen, Tag v${NEXT} setzen und pushen"
    else
        echo "${NEXT}" > VERSION
        read -r -p "„chore: release v${NEXT}“ mit Tag v${NEXT} committen und pushen? [j/N] " answer
        [[ "$answer" =~ ^[jJyY]$ ]] || { restore_version; fail "Abgebrochen – nichts geändert."; }
        git add VERSION
        git commit -q -m "chore: release v${NEXT}"
        git tag -a "v${NEXT}" -m "Release v${NEXT}"
        git push -q && git push -q origin "v${NEXT}"
    fi
fi

[[ -f public/build/manifest.json ]] || fail "Frontend-Build fehlt (public/build/manifest.json)."

# --- Upload --------------------------------------------------------------------------------
# Ausgeschlossen (und auf dem Server nie gelöscht): .env, Datenbankdateien, storage-Inhalte,
# Abhängigkeiten, Entwicklungs- und Testdateien.
RSYNC_EXCLUDES=(
    --exclude=.git/ --exclude=.github/ --exclude=.githooks/ --exclude=.claude/
    --exclude=node_modules/ --exclude=vendor/ --exclude=tests/ --exclude=docs/
    --exclude=.env --exclude='.env.*' --exclude='*.local' --exclude='*.local.*' --exclude=deploy.example.env
    --exclude='database/*.sqlite*' --exclude='*.sqlite' --exclude='*.sqlite3'
    --exclude='storage/*' --exclude='bootstrap/cache/*.php' --exclude=public/hot
    --exclude=.phpunit.cache/ --exclude=.phpunit.result.cache --exclude=.DS_Store
    --exclude=.idea/ --exclude=.vscode/ --exclude=.zed/ --exclude=.cursor/
)
RSYNC_FLAGS=(-az --delete "${RSYNC_EXCLUDES[@]}")
$DRY_RUN && RSYNC_FLAGS+=(--dry-run --itemize-changes)

say "Upload"
if [[ "$DEPLOY_SSH" == "local" ]]; then
    mkdir -p "$DEPLOY_PATH"
    rsync "${RSYNC_FLAGS[@]}" ./ "$DEPLOY_PATH/"
else
    rsync "${RSYNC_FLAGS[@]}" -e "${SSH_CMD[*]}" ./ "$DEPLOY_SSH:$DEPLOY_PATH/"
fi

if $DRY_RUN; then
    say "[Probelauf] Würde auf dem Server ausführen: composer install --no-dev, migrate --force, config/route/view:cache"
    exit 0
fi

# --- Server --------------------------------------------------------------------------------
say "Server: Abhängigkeiten, Migrationen, Caches"
# Ältere Composer-Versionen melden unter neuem PHP viele harmlose „Deprecated“-Hinweise über sich selbst –
# diese Zeilen werden ausgeblendet; echte Fehler bleiben sichtbar und brechen weiterhin ab (pipefail).
remote "set -o pipefail; mkdir -p storage/app/private storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && $DEPLOY_COMPOSER install --no-dev --optimize-autoloader --no-interaction --no-progress 2>&1 \
       | { grep -v -E '^(PHP )?Deprecat|^Deprecation Notice|^$' || true; } \
    && $DEPLOY_PHP artisan migrate --force \
    && $DEPLOY_PHP artisan config:cache \
    && $DEPLOY_PHP artisan route:cache \
    && $DEPLOY_PHP artisan view:cache"

say "Fertig – Version ${NEXT} ist online."
